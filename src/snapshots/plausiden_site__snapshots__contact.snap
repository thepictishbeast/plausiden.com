" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-menu w-6 h-6"><line x1="4" x2="20" y1="12" y2="12"></line><line x1="4" x2="20" y1="6" y2="6"></line><line x1="4" x2="20" y1="18" y2="18"></line></svg></button></div><div id="mobile-menu" class="lg:hidden hidden border-t border-slate-200 bg-white" aria-hidden="true"><div class="container mx-auto px-4 py-4 flex flex-col gap-3"><a href="/services" class="text-sm font-medium text-slate-700 hover:text-primary py-2">Services</a><a href="/case-studies" class="text-sm font-medium text-slate-700 hover:text-primary py-2">Case Studies</a><a href="/pricing-transparency" class="text-sm font-medium text-slate-700 hover:text-primary py-2">Pricing</a><a href="/about" class="text-sm font-medium text-slate-700 hover:text-primary py-2">About</a><a href="/blog" class="text-sm font-medium text-slate-700 hover:text-primary py-2">Insights</a><a href="/contact" class="inline-flex items-center justify-center gap-2 whitespace-nowrap font-medium rounded-md bg-primary text-primary-foreground min-h-8 px-3 text-xs py-2">Book a scoping call</a></div></div></nav><main id="main" tabindex="-1" class="flex-grow"><div class="pt-20 min-h-screen bg-slate-50"><div class="bg-slate-900 text-white py-16"><div class="container mx-auto px-4 md:px-6 text-center"><div class="mb-4"><h1 class="font-display font-bold leading-tight text-4xl md:text-5xl lg:text-6xl text-white">Contact Us</h1></div><p class="text-lg md:text-xl leading-relaxed text-slate-400">Book a 45-minute scoping call. Mutual NDA first, then a written proposal with specific scope and a specific price — not an hourly estimate that moves.</p></div></div><div class="container mx-auto px-4 md:px-6 py-16 -mt-10"><div class="grid grid-cols-1 lg:grid-cols-3 gap-8"><div class="lg:col-span-1 space-y-6 pd-reveal"><div class="shadcn-card rounded-xl border border-card-border text-card-foreground border-none shadow-xl bg-white overflow-hidden"><div class="bg-primary p-6"><h3 class="text-white font-display text-xl font-bold">Get in touch</h3><p class="text-primary-foreground/80 mt-2 text-sm">You will be talking to the engineer who would do the work, not a call centre or an account manager.</p></div><div class="p-8 space-y-8"><div class="flex items-start gap-4"><div class="bg-primary/10 p-3 rounded-lg"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 text-primary"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg></div><div><p class="font-semibold text-slate-900">Phone</p><a href="tel:9783516495" class="text-slate-600 hover:text-primary transition-colors">978-351-6495</a></div></div><div class="flex items-start gap-4"><div class="bg-primary/10 p-3 rounded-lg"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 text-primary"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg></div><div><p class="font-semibold text-slate-900">Email</p><a href="mailto:team@plausiden.com" class="text-slate-600 hover:text-primary transition-colors">team@plausiden.com</a></div></div><div class="flex items-start gap-4"><div class="bg-primary/10 p-3 rounded-lg"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 text-primary"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg></div><div><p class="font-semibold text-slate-900">Location</p><p class="text-slate-600">Massachusetts, USA</p></div></div></div></div></div><div class="lg:col-span-2 pd-reveal"><div class="shadcn-card rounded-xl border bg-card border-card-border text-card-foreground border-none shadow-xl"><div class="p-8 md:p-10"><div class="mb-6"><h2 class="font-display font-bold leading-tight text-xl text-slate-900">Send us a message</h2></div><form action="/contact" method="post" class="space-y-6"><div class="sr-only" aria-hidden="true"><label for="contact-website">Leave this field empty</label><input type="text" id="contact-website" name="website" tabindex="-1" autocomplete="off" value=""></div><div class="grid grid-cols-1 md:grid-cols-2 gap-6"><div class="space-y-2" data-loom-form-style="rounded"><label class="text-sm font-medium leading-none" for="contact-name">Full Name</label><input type="text" id="contact-name" name="name" class="flex w-full border focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 ring-offset-background text-base md:text-sm rounded-md border-input bg-slate-50 px-3 py-2 h-12" placeholder="John Doe" maxlength="100"></div><div class="space-y-2" data-loom-form-style="rounded"><label class="text-sm font-medium leading-none" for="contact-email">Email Address</label><input type="email" id="contact-email" name="email" class="flex w-full border focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 ring-offset-background text-base md:text-sm rounded-md border-input bg-slate-50 px-3 py-2 h-12" placeholder="john@company.com" maxlength="200" required></div></div><div class="grid grid-cols-1 md:grid-cols-2 gap-6"><div class="space-y-2" data-loom-form-style="rounded"><label class="text-sm font-medium leading-none" for="contact-phone">Phone Number</label><input type="tel" id="contact-phone" name="phone" class="flex w-full border focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 ring-offset-background text-base md:text-sm rounded-md border-input bg-slate-50 px-3 py-2 h-12" placeholder="(555) 000-0000" maxlength="50"></div><div class="space-y-2" data-loom-form-style="rounded"><label class="text-sm font-medium leading-none" for="contact-company">Company Name</label><input type="text" id="contact-company" name="company" class="flex w-full border focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 ring-offset-background text-base md:text-sm rounded-md border-input bg-slate-50 px-3 py-2 h-12" placeholder="Your Business LLC" maxlength="200"></div></div><div class="space-y-2" data-loom-form-style="rounded"><label class="text-sm font-medium leading-none" for="contact-service">Service Interest</label><select id="contact-service" name="service" class="flex w-full border focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 ring-offset-background text-base md:text-sm rounded-md border-input bg-slate-50 px-3 py-2 h-12"><option value="">Select a service</option><option value="IT Operations">IT Operations</option><option value="Cyber Security">Cyber Security</option><option value="Artificial Intelligence">Artificial Intelligence</option><option value="Industrial Automation">Industrial Automation</option><option value="Software Development">Software Development</option><option value="Hardware Solutions">Hardware Solutions</option><option value="Networking">Networking</option><option value="Other">Other / General Inquiry</option></select></div><div class="space-y-2" data-loom-form-style="rounded"><label class="text-sm font-medium leading-none" for="contact-message">Message</label><textarea id="contact-message" name="message" class="flex w-full border focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 ring-offset-background text-base md:text-sm rounded-md border-input bg-slate-50 px-3 py-2 min-h-[150px] resize-none" placeholder="Tell us about your project or requirements..." maxlength="5000" required></textarea></div><div class="w-full"><button type="submit" class="inline-flex items-center justify-center gap-2 whitespace-nowrap font-medium focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 transition-colors h-12 px-8 py-6 text-lg rounded-xl bg-primary text-primary-foreground border border-primary-border hover:bg-primary/90 shadow-lg shadow-primary/20 hover:shadow-xl" aria-label="Send Message" data-loom-button-shape="rounded">Send Message</button></div></form></div></div></div></div></div></div></main><footer class="bg-slate-900 text-slate-300 py-16" data-loom-footer-style="standard"><div class="container mx-auto loom-shell"><div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12"><div class="space-y-6"><div class="flex items-center gap-3 text-white"><div class="bg-primary p-1.5 rounded-lg"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 text-white"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/></svg></div><span class="font-display font-bold text-xl tracking-tight whitespace-nowrap">PlausiDen <span class="text-primary">LLC</span></span></div><p class="text-slate-400 text-sm leading-relaxed max-w-xs">Security and IT engineering for firms that hold sensitive client data. Fixed scope, fixed price, and the engineer who did the work on the call.</p></div><div class="space-y-6"><h3 class="text-white font-display font-semibold text-lg">Company</h3><ul class="space-y-3"><li><a href="/"><span class